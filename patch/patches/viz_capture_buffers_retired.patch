+  if (!consumer_) {
+    // Between Stop() and the next Start() there is nobody to tell, and that is
+    // precisely when the pool being replaced destroys its buffers. Hold them:
+    // a token the next consumer does not recognise costs it nothing to ignore,
+    // while a token it does recognise is memory it would otherwise never free.
+    // Bounded by the pool's capacity, since no new buffers are made meanwhile.
+    pending_retired_buffers_.push_back(buffer_token);
+    return;
+  }
